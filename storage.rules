rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product images: public read, admin-only write/delete (via the admin app).
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Lookbook images: public read, admin-only write/delete (via the admin app).
    match /lookbook/{lookbookId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}
